# Web admin / Vite frontend
VITE_API_URL=

# Production example (no trailing slash):
# VITE_API_URL=https://praynow-api.onrender.com

# Google Places (server scripts — also set in server/.env)
# GOOGLE_PLACES_API_KEY=

# Google Maps JavaScript key for the owner desk map (a browser key: restrict it to http://localhost:5173/* and your desk address,
# and turn on Maps JavaScript API; Geocoding API too if you want the Find box). Do not reuse the server key here.
# VITE_GOOGLE_MAPS_API_KEY=
