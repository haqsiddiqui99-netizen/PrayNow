# Development (in-memory DB — mock-friendly, no PostgreSQL required)
DATABASE_URL=memory://local

# Production PostgreSQL (required for live / hosted data)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/praynow
PGSCHEMA=praynow

# Strong secret in production — never ship the default
JWT_SECRET=praynow-dev-secret-change-me
NODE_ENV=development

# Admin seed (created on first db:seed)
SEED_ADMIN_EMAIL=admin@praynow.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=PrayNow Admin
# Mobile login for the app (10 digits) — use this on the mobile Sign in screen
SEED_ADMIN_MOBILE=9999999999

# Demo mosque admin (assigned to one seeded mosque)
# SEED_MANAGER_MOBILE=8888888888
# SEED_MANAGER_PASSWORD=Manager@12345

PORT=5000
HOST=0.0.0.0

# Aladhan city calendar (Generate year from Aladhan)
# ALADHAN_METHOD=1
# Set true only if corporate TLS blocks api.aladhan.com
# ALADHAN_TLS_INSECURE=true
# Bulk Tier-1 load: node scripts/import-tier1-aladhan.mjs 2026
# Or subset: node scripts/import-tier1-aladhan.mjs 2026 "Mumbai,Navi Mumbai,Thane"

# Mosque data — fetch once, serve forever (no repeated OSM / Google billing)
#
# Step 1 — ONE-TIME fetch from OSM (free, no API key):
#   node server/scripts/fetch-city-mosques-osm.mjs --all
#   node server/scripts/fetch-city-mosques-osm.mjs Delhi
#
# Step 1b — OPTIONAL Google Places enrichment (needs key, costs money):
#   node server/scripts/fetch-city-mosques-places.mjs Delhi
#
# Results are saved under server/data/<city>-mosques-osm.json (and -places.json).
#
# Step 2 — Import saved JSON into Postgres (reads files only, no external API):
#   npm run mosques:import-all
#
# Step 3 — Every API restart also merges any NEW mosques from server/data/*.json
# automatically (duplicates are skipped). Set HYDRATE_LOCAL_MOSQUES=false to disable.
# HYDRATE_LOCAL_MOSQUES=false
# GOOGLE_PLACES_API_KEY=

# Comma-separated allowed web origins (hosted admin dashboard + preview)
# CLIENT_ORIGIN=https://praynow.vercel.app,https://admin.yourdomain.com

# Islamic AI chat (OpenAI)
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=1024
# Set true only in dev if corporate proxy causes TLS errors
# OPENAI_TLS_INSECURE=true
# OPENAI_MAX_TOKENS=1024

# Live azan streaming (Agora RTC)
# Create a free project at https://console.agora.io
# - App ID only  → clients can join with just the App ID (project in testing mode)
# - App ID + Certificate → secure, tokens are generated per session (recommended)
# AGORA_APP_ID=your-agora-app-id
# AGORA_APP_CERTIFICATE=your-agora-app-certificate
