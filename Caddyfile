# Serves the public app and the owner desk, and forwards /api to the API service.
# Set API_UPSTREAM to the API, for example http://praynow-api.railway.internal:8080
:{$PORT:8080} {
	encode gzip

	@api path /api /api/*
	handle @api {
		reverse_proxy {$API_UPSTREAM:localhost:5000}
	}

	handle /_desk/* {
		uri strip_prefix /_desk
		root * /srv/desk
		file_server
	}

	handle /portal* {
		root * /srv/desk
		try_files {path} {path}/index.html /portal/index.html
		file_server
	}

	handle /privacy* {
		root * /srv/desk
		try_files {path} {path}/index.html /privacy/index.html
		file_server
	}

	handle /delete-account* {
		root * /srv/desk
		try_files {path} {path}/index.html /delete-account/index.html
		file_server
	}

	handle /favicon.svg {
		root * /srv/desk
		file_server
	}

	handle {
		root * /srv/app
		try_files {path} {path}/ /index.html
		file_server
	}
}
