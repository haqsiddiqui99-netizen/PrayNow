{
  "expo": {
    "name": "PrayNow",
    "slug": "praynow",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "praynow",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PrayNow uses your location for nearby mosques, prayer times, and live Qibla direction."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d47a1"
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#0d47a1"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow PrayNow to find nearby mosques, prayer times, and Qibla direction."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
